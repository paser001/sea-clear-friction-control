<?xml version="1.0"?>
<robot name="finger2r_down">
  <link name="base"/>

  <link name="link1">
    <inertial>
      <origin xyz="0 0 -0.03"/>
      <mass value="0.15"/>
      <inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.03"/>
      <geometry><box size="0.014 0.014 0.06"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.03"/>
      <geometry><box size="0.014 0.014 0.06"/></geometry>
    </collision>
  </link>

  <joint name="j1" type="revolute">
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="25" velocity="8.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="link2">
    <inertial>
      <origin xyz="0 0 -0.025"/>
      <mass value="0.12"/>
      <inertia ixx="8e-5" iyy="8e-5" izz="8e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.025"/>
      <geometry><box size="0.013 0.013 0.05"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.025"/>
      <geometry><box size="0.013 0.013 0.05"/></geometry>
    </collision>
  </link>

  <joint name="j2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 -0.06"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="25" velocity="8.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>
</robot>
