<?xml version="1.0"?>
<robot name="finger2r">

  <!-- Base -->
  <link name="base"/>

  <!-- Link 1 -->
  <link name="link1">
    <inertial>
      <origin xyz="0.25 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <!-- Replace inertia with values from your chosen geometry (see python generator below) -->
      <inertia ixx="0.0030" iyy="0.0030" izz="0.0018" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0.25 0 0" rpy="0 0 0"/>
      <geometry><box size="0.5 0.08 0.08"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.25 0 0" rpy="0 0 0"/>
      <geometry><box size="0.5 0.08 0.08"/></geometry>
    </collision>
  </link>

  <!-- Joint 1 -->
  <joint name="joint1" type="revolute">
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.8" upper="1.8" effort="200" velocity="6.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <!-- Link 2 -->
  <link name="link2">
    <inertial>
      <origin xyz="0.25 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.0030" iyy="0.0030" izz="0.0018" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0.25 0 0" rpy="0 0 0"/>
      <geometry><box size="0.5 0.07 0.07"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.25 0 0" rpy="0 0 0"/>
      <geometry><box size="0.5 0.07 0.07"/></geometry>
    </collision>
  </link>

  <!-- Joint 2 -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.5 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.8" upper="1.8" effort="200" velocity="6.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

</robot>
