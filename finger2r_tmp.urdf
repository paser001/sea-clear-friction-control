<?xml version="1.0"?>
<robot name="finger2r">
  <link name="base"/>

  <link name="link1">
    <inertial>
      <origin xyz="0.03 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0.03 0 0"/>
      <geometry><box size="0.06 0.014 0.014"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.03 0 0"/>
      <geometry><box size="0.06 0.014 0.014"/></geometry>
    </collision>
  </link>

  <joint name="j1" type="revolute">
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.5" upper="2.5" effort="10" velocity="8.0"/>
    <dynamics damping="0.02" friction="0.00"/>
  </joint>

  <link name="link2">
    <inertial>
      <origin xyz="0.025 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="8e-5" iyy="8e-5" izz="8e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0.025 0 0"/>
      <geometry><box size="0.05 0.013 0.013"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.025 0 0"/>
      <geometry><box size="0.05 0.013 0.013"/></geometry>
    </collision>
  </link>

  <joint name="j2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.06 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.5" upper="2.5" effort="10" velocity="8.0"/>
    <dynamics damping="0.02" friction="0.00"/>
  </joint>
</robot>
